<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Historial de recomendaciones</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="/css/colors.css" rel="stylesheet"/>
        <link href="/css/usuario.css" rel="stylesheet"/>
    </head>
    <body>

        <%- include('../partials/navbarUsuario') %>

        <div class="d-flex">

            <%- include('../partials/sidebarUsuario', { currentPage: 'historial-recomendaciones' }) %>

            <div class="usuario-content">

                <h1 class="usuario-page-title mb-4">Historial</h1>

                <!-- FILTROS -->
                <div class="mb-4 d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary active" data-filtro="todas">Todas</button>
                    <button class="btn btn-sm btn-outline-secondary" data-filtro="recomendadas">Recomendadas</button>
                    <button class="btn btn-sm btn-outline-secondary" data-filtro="no-recomendadas">No recomendadas</button>
                </div>

                <!-- LISTA -->
                <div id="listaHistorial" class="row g-3">
                    <p class="text-muted">Cargando...</p>
                </div>

            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/js/historialRecomendaciones.js"></script>
    </body>
</html>