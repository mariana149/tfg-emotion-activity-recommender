<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Emociones</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="/css/colors.css" rel="stylesheet">
        <link href="/css/usuario.css" rel="stylesheet">
    </head>
    <body>

    <%- include('../partials/navbarUsuario') %>

    <div class="d-flex">

        <%- include('../partials/sidebarUsuario', { currentPage: 'emociones' }) %>

        <div class="usuario-content">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="usuario-page-title mb-0">Mis emociones</h1>
                <button
                    class="btn gradient-custom text-dark"
                    data-bs-toggle="modal"
                    data-bs-target="#modalEmocion">
                    <i class="bi bi-plus-lg me-1"></i>Registrar emoción
                </button>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="row g-4">

                <!-- CALENDARIO -->
                <div class="col-12 col-lg-7">
                    <div class="card shadow-sm h-100 ">
                        <div class="card-body">
                            <div id="calendar"></div>
                        </div>
                    </div>
                </div>

                <!-- GRÁFICAS -->
                <div class="col-12 col-lg-5">

                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h5 class="mb-1">Evolución emocional</h5>
                            <p class="text-muted small mb-3">Evolución de tu estado emocional en los últimos 30 días. Valores positivos indican bienestar (máx. 5), negativos malestar (máx. -10).</p>
                            <div class="grafica-container">
                                <canvas id="graficaEvolucion"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="mb-3">Distribución de emociones</h5>
                            <div class="grafica-container">
                                <canvas id="graficaDistribucion"></canvas>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

    <!-- MODAL EMOCIÓN -->
    <div class="modal fade" id="modalEmocion" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/emociones/registrar" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Registrar estado de ánimo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="form-label">¿Cómo te sientes?</label>
                            <select name="emotion" class="form-select" required>
                                <option value="1">😊 Feliz</option>
                                <option value="2">😌 Calma</option>
                                <option value="3">😐 Neutral</option>
                                <option value="4">😔 Triste</option>
                                <option value="5">😣 Estrés</option>
                                <option value="6">😰 Ansiedad</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between">
                                <span>Intensidad emocional</span>
                                <span id="lblIntensidad" class="text-muted">3</span>
                            </label>
                            <input
                                type="range"
                                class="form-range"
                                name="intensity"
                                min="1" max="5" value="3"
                                oninput="document.getElementById('lblIntensidad').textContent=this.value"
                                required>
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Muy leve</small>
                                <small class="text-muted">Muy intensa</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nivel de energía</label>
                            <select name="energy_level" class="form-select" required>
                                <option value="">Selecciona...</option>
                                <option value="baja">Baja</option>
                                <option value="media">Media</option>
                                <option value="alta">Alta</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Notas <span class="text-muted">(opcional)</span></label>
                            <textarea class="form-control" name="notes" rows="3" placeholder="¿Qué ha pasado hoy?"></textarea>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn gradient-custom text-dark">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- MODAL DETALLE EMOCIÓN -->
    <div class="modal fade" id="modalDetalleEmocion" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalle de emoción</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 text-center" id="detalleEstado"></div>
                    <table class="table table-sm mb-0">
                        <tr><td class="text-muted">Intensidad</td><td id="detalleIntensidad"></td></tr>
                        <tr><td class="text-muted">Energía</td><td id="detalleEnergia"></td></tr>
                        <tr><td class="text-muted">Registrado</td><td id="detalleFecha"></td></tr>
                        <tr><td class="text-muted">Notas</td><td id="detalleNotas"></td></tr>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="/js/calendario.js"></script>
    <script src="/js/emotionsCharts.js"></script>

    <% if (typeof error !== 'undefined' && error) { %>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            new bootstrap.Modal(document.getElementById('modalEmocion')).show();
        });
    </script>
    <% } %>
    <script>
        document.getElementById('modalEmocion').addEventListener('hidden.bs.modal', function() {
            document.querySelector('[name=emotion]').value = '1';
            document.querySelector('[name=intensity]').value = '3';
            document.getElementById('lblIntensidad').textContent = '3';
            document.querySelector('[name=energy_level]').value = '';
            document.querySelector('[name=notes]').value = '';
        });
    </script>
    </body>
</html>
