<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Inicio</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="/css/colors.css" rel="stylesheet"/>
        <link href="/css/usuario.css" rel="stylesheet"/>
    </head>
    <body>

        <%- include('../partials/navbarUsuario') %>

        <div class="d-flex">

            <%- include('../partials/sidebarUsuario', { currentPage: 'inicio' }) %>

            <div class="usuario-content">

                <!-- SALUDO -->
                <div class="perfil-banner gradient-custom rounded-3 mb-4 p-4">
                    <h3 class="mb-1">Hola, <%= user.nombre || 'usuario' %> 👋</h3>
                    <p class="text-muted mb-0">Bienvenido a tu espacio de bienestar emocional.</p>
                </div>

                <!-- STATS -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="card shadow-sm text-center p-3">
                            <i class="bi bi-emoji-smile text-warning mb-2" style="font-size:1.5rem;"></i>
                            <h4 class="mb-0" id="statEmociones">—</h4>
                            <small class="text-muted">Emociones</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card shadow-sm text-center p-3">
                            <i class="bi bi-check-circle text-success mb-2" style="font-size:1.5rem;"></i>
                            <h4 class="mb-0" id="statActividades">—</h4>
                            <small class="text-muted">Actividades</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card shadow-sm text-center p-3">
                            <i class="bi bi-stars text-primary mb-2" style="font-size:1.5rem;"></i>
                            <h4 class="mb-0" id="statRecomendaciones">—</h4>
                            <small class="text-muted">Recomendaciones</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card shadow-sm text-center p-3">
                            <i class="bi bi-people text-info mb-2" style="font-size:1.5rem;"></i>
                            <h4 class="mb-0" id="statConexiones">—</h4>
                            <small class="text-muted">Conexiones</small>
                        </div>
                    </div>
                </div>

                <div class="row g-4">

                    <!-- ÚLTIMA EMOCIÓN -->
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="mb-0">Última emoción</h5>
                                    <a href="/emociones" class="btn btn-sm gradient-custom text-dark">
                                        <i class="bi bi-plus-lg me-1"></i>Registrar
                                    </a>
                                </div>
                                <div id="ultimaEmocion">
                                    <p class="text-muted">Cargando...</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ÚLTIMA RECOMENDACIÓN -->
                    <div class="col-12 col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="mb-0">Última recomendación</h5>
                                    <a href="/recomendaciones" class="btn btn-sm gradient-custom text-dark">
                                        <i class="bi bi-stars me-1"></i>Solicitar
                                    </a>
                                </div>
                                <div id="ultimaRecomendacion">
                                    <p class="text-muted">Cargando...</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/js/inicio.js"></script>
    </body>
</html>