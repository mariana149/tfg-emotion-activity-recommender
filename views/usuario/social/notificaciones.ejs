<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Notificaciones</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="/css/colors.css" rel="stylesheet"/>
        <link href="/css/usuario.css" rel="stylesheet"/>
    </head>
    <body>

        <%- include('../../partials/navbarUsuario') %>

        <div class="d-flex">

            <%- include('../../partials/sidebarUsuario', { currentPage: 'notificaciones' }) %>

            <div class="usuario-content">

                <h1 class="usuario-page-title mb-4">Notificaciones</h1>

                <% const totalPendientes = solicitudesRecibidas.length + recomendaciones.length %>

                <% if (totalPendientes === 0) { %>
                <div class="card shadow-sm p-5 text-center text-muted">
                    <i class="bi bi-bell" style="font-size:2.5rem;opacity:.3;"></i>
                    <p class="mt-3 mb-0">No tienes notificaciones pendientes</p>
                </div>
                <% } %>

                <!-- SOLICITUDES DE CONEXIÓN RECIBIDAS -->
                <% if (solicitudesRecibidas.length > 0) { %>
                <div class="card shadow-sm p-4 mb-4">
                    <h5 class="mb-3">
                        <i class="bi bi-person-plus me-2 text-success"></i>Solicitudes de conexión
                        <span class="badge bg-success ms-2"><%= solicitudesRecibidas.length %></span>
                    </h5>
                    <div class="row g-3">
                        <% solicitudesRecibidas.forEach(s => { %>
                        <div class="col-12 col-md-6" id="solicitud-<%= s.id %>">
                            <div class="d-flex align-items-center gap-3 p-3 border rounded flex-wrap">
                                <img src="<%= s.foto || '/img/defaultFoto.png' %>"
                                    class="rounded-circle" width="48" height="48"
                                    style="object-fit:cover;">
                                <div class="flex-grow-1">
                                    <div class="fw-500"><%= s.nombre %> <%= s.apellidos || '' %></div>
                                    <small class="text-muted">
                                        <%= new Date(s.created_at).toLocaleDateString('es-ES') %>
                                    </small>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-success"
                                            onclick="aceptarSolicitud(<%= s.id %>)">
                                        <i class="bi bi-check-lg"></i> Aceptar
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            onclick="rechazarSolicitud(<%= s.id %>)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <!-- RECOMENDACIONES SOCIALES RECIBIDAS -->
                <% if (recomendaciones.length > 0) { %>
                <div class="card shadow-sm p-4 mb-4">
                    <h5 class="mb-3">
                        <i class="bi bi-stars me-2 text-success"></i>Actividades recomendadas
                        <span class="badge bg-success ms-2"><%= recomendaciones.length %></span>
                    </h5>
                    <div class="row g-3">
                        <% recomendaciones.forEach(r => { %>
                        <div class="col-12 col-md-6" id="recsocial-<%= r.id %>">
                            <div class="card border h-100">
                                <div class="card-body">
                                    <!-- Remitente -->
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <img src="<%= r.remitente_foto || '/img/defaultFoto.png' %>"
                                            class="rounded-circle" width="32" height="32"
                                            style="object-fit:cover;">
                                        <small class="text-muted">
                                            <strong><%= r.remitente_nombre %> <%= r.remitente_apellidos || "" %></strong> te recomienda:
                                        </small>
                                    </div>
                                    <!-- Actividad -->
                                    <h6 class="fw-500 mb-1"><%= r.activity_nombre %></h6>
                                    <p class="text-muted small mb-2">
                                        <%= r.description || 'Sin descripción' %>
                                    </p>
                                    <div class="d-flex gap-1 flex-wrap mb-2">
                                        <% if (r.duracion) { %>
                                        <span class="badge bg-light text-muted">
                                            <i class="bi bi-clock me-1"></i><%= r.duracion %> min
                                        </span>
                                        <% } %>
                                        <% if (r.dificultad) { %>
                                        <span class="badge bg-light text-muted"><%= r.dificultad %></span>
                                        <% } %>
                                    </div>
                                    <!-- Mensaje -->
                                    <% if (r.mensaje) { %>
                                    <p class="fst-italic text-muted small mb-3">
                                        "<%= r.mensaje %>"
                                    </p>
                                    <% } %>
                                    <!-- Acciones -->
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-success w-100"
                                                onclick="aceptarRecSocial(<%= r.id %>)">
                                            <i class="bi bi-bookmark-check me-1"></i>Aceptar y guardar
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger w-100"
                                                onclick="rechazarRecSocial(<%= r.id %>)">
                                            <i class="bi bi-x-lg me-1"></i>Rechazar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

            </div>
        </div>

        <!-- TOAST -->
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
            <div id="toast" class="toast align-items-center text-white border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body" id="toastMsg"></div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/js/social.js"></script>
    </body>
</html>
