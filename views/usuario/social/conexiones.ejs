<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Mis conexiones</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="/css/colors.css" rel="stylesheet"/>
        <link href="/css/usuario.css" rel="stylesheet"/>
        <style>
            .dropdown-item-actividad:hover { background-color: #f0fdf4; color: #166534; }
        </style>
    </head>
    <body>

        <%- include('../../partials/navbarUsuario') %>

        <div class="d-flex">

            <%- include('../../partials/sidebarUsuario', { currentPage: 'social' }) %>

            <div class="usuario-content">

                <h1 class="usuario-page-title mb-4">Mis conexiones</h1>

                <!-- SOLICITUDES RECIBIDAS -->
                <% if (solicitudesRecibidas.length > 0) { %>
                <div class="card shadow-sm p-4 mb-4">
                    <h5 class="mb-3">
                        <i class="bi bi-person-plus me-2 text-success"></i>Solicitudes recibidas
                        <span class="badge bg-success ms-2"><%= solicitudesRecibidas.length %></span>
                    </h5>
                    <div class="row g-3">
                        <% solicitudesRecibidas.forEach(s => { %>
                        <div class="col-12 col-md-6" id="solicitud-<%= s.id %>">
                            <div class="d-flex align-items-center gap-3 p-3 border rounded">
                                <img src="<%= s.foto || '/img/defaultFoto.png' %>"
                                    class="rounded-circle" width="48" height="48"
                                    style="object-fit:cover;">
                                <div class="flex-grow-1">
                                    <div class="fw-500"><%= s.nombre %> <%= s.apellidos || "" %></div>
                                    <small class="text-muted">
                                        <%= new Date(s.created_at).toLocaleDateString('es-ES') %>
                                    </small>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-success"
                                            onclick="aceptarSolicitud(<%= s.id %>)">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            onclick="rechazarSolicitud(<%= s.id %>)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <!-- SOLICITUDES ENVIADAS -->
                <% if (solicitudesEnviadas.length > 0) { %>
                <div class="card shadow-sm p-4 mb-4">
                    <h5 class="mb-3">
                        <i class="bi bi-send me-2 text-muted"></i>Solicitudes enviadas
                    </h5>
                    <div class="row g-3">
                        <% solicitudesEnviadas.forEach(s => { %>
                        <div class="col-12 col-md-6" id="enviada-<%= s.id %>">
                            <div class="d-flex align-items-center gap-3 p-3 border rounded">
                                <img src="<%= s.foto || '/img/defaultFoto.png' %>"
                                    class="rounded-circle" width="48" height="48"
                                    style="object-fit:cover;">
                                <div class="flex-grow-1">
                                    <div class="fw-500"><%= s.nombre %> <%= s.apellidos || "" %></div>
                                    <small class="text-muted">Pendiente</small>
                                </div>
                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="cancelarSolicitud(<%= s.id %>)">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <!-- CONEXIONES ACEPTADAS -->
                <div class="card shadow-sm p-4 mb-4">
                    <div class="d-flex align-items-center mb-3 flex-wrap gap-2">
                        <h5 class="mb-0">
                            <i class="bi bi-people me-2 text-success"></i>Conectados
                            <span class="badge bg-light text-muted ms-2"><%= conexiones.length %></span>
                        </h5>
                        <a href="/buscar-usuarios" class="btn btn-success btn-sm ms-sm-auto">
                            <i class="bi bi-search me-1"></i>Buscar usuarios
                        </a>
                    </div>

                    <div class="input-group mb-3">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="filtroConexiones" class="form-control border-start-0"
                            placeholder="Filtrar por nombre...">
                    </div>

                    <% if (conexiones.length === 0) { %>
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-people" style="font-size:2.5rem;opacity:.3;"></i>
                        <p class="mt-2 mb-0">Aún no tienes conexiones</p>
                    </div>
                    <% } else { %>
                    <div class="row g-3" id="listaConexiones">
                        <% conexiones.forEach(c => { %>
                        <div class="col-12 col-md-6 col-lg-4" id="conexion-<%= c.id %>">
                            <div class="d-flex align-items-center gap-3 p-3 border rounded">
                                <img src="<%= c.foto || '/img/defaultFoto.png' %>"
                                    class="rounded-circle" width="48" height="48"
                                    style="object-fit:cover;">
                                <div class="flex-grow-1">
                                    <div class="fw-500"><%= c.nombre %> <%= c.apellidos || "" %></div>
                                    <small class="text-muted">
                                        Conectados desde <%= new Date(c.conectado_desde).toLocaleDateString('es-ES') %>
                                    </small>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <button class="dropdown-item"
                                                    onclick="abrirModalRecomendar(<%= c.amigo_id %>, '<%= c.nombre %>')">
                                                <i class="bi bi-stars me-2"></i>Recomendar actividad
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button class="dropdown-item text-danger"
                                                    onclick="desconectar(<%= c.id %>, '<%= c.nombre %>')">
                                                <i class="bi bi-person-x me-2"></i>Desconectar
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item text-danger"
                                                    onclick="bloquear(<%= c.amigo_id %>, '<%= c.nombre %>')">
                                                <i class="bi bi-slash-circle me-2"></i>Bloquear
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                </div>

                <!-- BLOQUEADOS -->
                <% if (bloqueados.length > 0) { %>
                <div class="card shadow-sm p-4 mb-4">
                    <h5 class="mb-3">
                        <i class="bi bi-slash-circle me-2 text-danger"></i>Bloqueados
                    </h5>
                    <div class="row g-3">
                        <% bloqueados.forEach(b => { %>
                        <div class="col-12 col-md-6" id="bloqueado-<%= b.id %>">
                            <div class="d-flex align-items-center gap-3 p-3 border rounded opacity-50">
                                <img src="<%= b.foto || '/img/defaultFoto.png' %>"
                                    class="rounded-circle" width="48" height="48"
                                    style="object-fit:cover;">
                                <div class="flex-grow-1">
                                    <div class="fw-500"><%= b.nombre %> <%= b.apellidos || "" %></div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary"
                                        onclick="desbloquear(<%= b.bloqueado_id %>, '<%= b.nombre %>')">
                                    Desbloquear
                                </button>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

            </div>
        </div>

        <!-- MODAL RECOMENDAR ACTIVIDAD -->
        <div class="modal fade" id="modalRecomendar" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Recomendar actividad</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted mb-3">
                            Recomendando a <strong id="nombreDestinatario"></strong>
                        </p>
                        <input type="hidden" id="destinatarioId">
                        <input type="hidden" id="actividadSeleccionadaId">
                        <div class="mb-3">
                            <label class="form-label" for="inputBuscarActividad">Actividad</label>
                            <div class="position-relative">
                                <input type="text" id="inputBuscarActividad" class="form-control"
                                    placeholder="Buscar actividad..."
                                    autocomplete="off"
                                    oninput="filtrarActividades(this.value)">
                                <div id="dropdownActividades"
                                    class="d-none position-absolute w-100 border rounded bg-white shadow-sm"
                                    style="z-index:1060;max-height:200px;overflow-y:auto;top:100%;left:0;">
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="mensajeRec">Mensaje (opcional)</label>
                            <input type="text" id="mensajeRec" class="form-control"
                                placeholder="Ej: ¡A ti te encantará!" maxlength="300">
                        </div>
                        <p id="errorRecomendar" class="text-danger small d-none">Selecciona una actividad</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-success" onclick="enviarRecomendacion()">
                            <i class="bi bi-stars me-1"></i>Recomendar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOAST -->
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
            <div id="toast" class="toast align-items-center text-white border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body" id="toastMsg"></div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/js/social.js"></script>
        <script>
            // Filtro en tiempo real sobre las cards ya cargadas
            const inputFiltro = document.getElementById('filtroConexiones');
            if (inputFiltro) {
                inputFiltro.addEventListener('input', function () {
                    const q = this.value.toLowerCase().trim();
                    document.querySelectorAll('#listaConexiones [id^="conexion-"]').forEach(card => {
                        const nombre = card.querySelector('.fw-500').textContent.toLowerCase().trim();
                        card.style.display = nombre.includes(q) ? '' : 'none';
                    });
                });
            }
        </script>
    </body>
</html>
