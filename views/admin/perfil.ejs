<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Mi perfil - Admin</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="/css/admin.css" rel="stylesheet"/>
    </head>
    <body>

        <%- include('../partials/navbarAdmin') %>

        <div class="d-flex">

            <%- include('../partials/sidebarAdmin', { currentPage: 'perfil' }) %>

            <div class="admin-content">

                <h1 class="admin-page-title">Mi perfil</h1>

                <% if (flash && flash.type === 'success') { %>
                <div class="alert alert-success alert-dismissible fade show">
                    <%= flash.msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                <% if (flash && flash.type === 'error') { %>
                <div class="alert alert-danger alert-dismissible fade show">
                    <%= flash.msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                <!-- MODAL CAMBIAR EMAIL -->
                <div class="modal fade" id="modalEmail" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Cambiar email</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form action="/admin/perfil/datos" method="POST">
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label" for="emailInput">Nuevo email</label>
                                        <input type="email" id="emailInput" name="email" class="form-control"
                                            value="<%= usuario.email %>" required>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-primary">Guardar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- MODAL CAMBIAR CONTRASEÑA -->
                <div class="modal fade" id="modalPassword" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Cambiar contraseña</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form action="/admin/perfil/password" method="POST">
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label" for="newPassword">Nueva contraseña</label>
                                        <input type="password" id="newPassword" name="newPassword"
                                            class="form-control" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="repetirPassword">Repetir contraseña</label>
                                        <input type="password" id="repetirPassword"
                                            class="form-control" required>
                                    </div>
                                    <p id="errorPassword" class="text-danger small d-none">Las contraseñas no coinciden</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-primary" id="btnGuardarPassword">Guardar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- CONTENIDO -->
                <div class="row">
                    <div class="col-12 col-md-8">
                        <div class="admin-card">
                            <div class="admin-perfil-row">
                                <span class="admin-perfil-label">Email</span>
                                <div class="d-flex align-items-center gap-2">
                                    <span><%= usuario.email %></span>
                                    <button class="admin-btn" data-bs-toggle="modal" data-bs-target="#modalEmail">
                                        Cambiar
                                    </button>
                                </div>
                            </div>
                            <div class="admin-perfil-row">
                                <span class="admin-perfil-label">Contraseña</span>
                                <button class="admin-btn" data-bs-toggle="modal" data-bs-target="#modalPassword">
                                    Cambiar contraseña
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script>
            document.getElementById('modalEmail').addEventListener('hidden.bs.modal', function() {
                document.getElementById('emailInput').value = '<%= usuario.email %>';
            });

            document.getElementById('modalPassword').addEventListener('hidden.bs.modal', function() {
                document.getElementById('newPassword').value     = '';
                document.getElementById('repetirPassword').value = '';
                document.getElementById('errorPassword').classList.add('d-none');
            });
            // Validar que las contraseñas coincidan antes de enviar
            document.getElementById('btnGuardarPassword').addEventListener('click', function(e) {
                const p1 = document.getElementById('newPassword').value;
                const p2 = document.getElementById('repetirPassword').value;
                if (p1 !== p2) {
                    e.preventDefault();
                    document.getElementById('errorPassword').classList.remove('d-none');
                } else {
                    document.getElementById('errorPassword').classList.add('d-none');
                }
            });
        </script>
    </body>
</html>
