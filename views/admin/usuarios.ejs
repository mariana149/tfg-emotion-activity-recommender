<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Usuarios - Admin</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="/css/admin.css" rel="stylesheet"/>
    </head>
    <body>

        <%- include('../partials/navbarAdmin') %>

        <div class="d-flex">

            <%- include('../partials/sidebarAdmin', { currentPage: 'usuarios' }) %>

            <div class="admin-content">

                <h1 class="admin-page-title">Gestión de usuarios</h1>

                <!-- MODAL VER -->
                <div class="modal fade" id="modalVer" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="verNombre"></h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <table class="admin-table">
                                    <tr><td class="text-muted">Email</td><td id="verEmail"></td></tr>
                                    <tr><td class="text-muted">País</td><td id="verPais"></td></tr>
                                    <tr><td class="text-muted">Ciudad</td><td id="verCiudad"></td></tr>
                                    <tr><td class="text-muted">Estado</td><td id="verEstado"></td></tr>
                                </table>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MODAL STATS -->
                <div class="modal fade" id="modalStats" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="statsNombre"></h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row g-2">
                                    <div class="col-12 col-sm-6">
                                        <div class="admin-stat-card text-center">
                                            <div class="admin-stat-label">Emociones registradas</div>
                                            <div class="admin-stat-value" id="statsEmociones">—</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="admin-stat-card text-center">
                                            <div class="admin-stat-label">Actividades realizadas</div>
                                            <div class="admin-stat-value" id="statsActividades">—</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="admin-stat-card text-center">
                                            <div class="admin-stat-label">Valoración media</div>
                                            <div class="admin-stat-value" id="statsValoracion">—</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="admin-stat-card text-center">
                                            <div class="admin-stat-label">Tasa de éxito</div>
                                            <div class="admin-stat-value" id="statsExito">—</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="admin-card">
                    <div class="admin-card-header">
                        <span class="fw-500">Usuarios</span>
                        <input type="text" id="buscador" class="admin-search ms-auto" placeholder="Nombre o email"/>
                        <button class="admin-filter-btn active" data-filtro="todos">Todos</button>
                        <button class="admin-filter-btn" data-filtro="activos">Activos</button>
                        <button class="admin-filter-btn" data-filtro="inactivos">Inactivos</button>
                    </div>
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th class="d-none d-md-table-cell">Email</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaUsuarios">
                                <% usuarios.filter(u => !u.admin).forEach(u => { %>
                                <tr
                                    data-id="<%= u.id %>"
                                    data-nombre="<%= u.nombre.toLowerCase() %>"
                                    data-email="<%= u.email.toLowerCase() %>"
                                    data-activo="<%= u.activo %>"
                                    data-nombre-completo="<%= u.nombre %> <%= u.apellidos %>"
                                    data-email-full="<%= u.email %>"
                                    data-pais="<%= u.pais || '—' %>"
                                    data-ciudad="<%= u.ciudad || '—' %>"
                                >
                                    <td><%= u.nombre %> <%= u.apellidos %></td>
                                    <td class="text-muted d-none d-md-table-cell"><%= u.email %></td>
                                    <td>
                                        <span class="admin-badge <%= u.activo ? 'admin-badge-green' : 'admin-badge-red' %>">
                                            <%= u.activo ? 'Activo' : 'Inactivo' %>
                                        </span>
                                    </td>
                                    <td>
                                        <button class="admin-btn btn-ver" data-id="<%= u.id %>">
                                            <i class="bi bi-eye"></i><span class="d-none d-lg-inline ms-1">Ver</span>
                                        </button>
                                        <button class="admin-btn btn-stats" data-id="<%= u.id %>">
                                            <i class="bi bi-bar-chart"></i><span class="d-none d-lg-inline ms-1">Stats</span>
                                        </button>
                                        <button class="admin-btn btn-toggle-activo"
                                            data-id="<%= u.id %>"
                                            data-activo="<%= u.activo %>">
                                            <% if (u.activo) { %>
                                                <i class="bi bi-x-circle"></i><span class="d-none d-lg-inline ms-1">Desactivar</span>
                                            <% } else { %>
                                                <i class="bi bi-check-circle"></i><span class="d-none d-lg-inline ms-1">Activar</span>
                                            <% } %>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/js/adminUsuarios.js"></script>
    </body>
</html>
