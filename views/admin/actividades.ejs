<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Actividades - Admin</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="/css/admin.css" rel="stylesheet"/>
    </head>
    <body>

        <%- include('../partials/navbarAdmin') %>

        <div class="d-flex">

            <%- include('../partials/sidebarAdmin', { currentPage: 'actividades' }) %>

            <div class="admin-content">

                <h1 class="admin-page-title">Gestión de actividades</h1>

                <!-- MODAL VER ACTIVIDAD -->
                <div class="modal fade" id="modalVer" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="verNombre"></h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <table class="admin-table">
                                    <tr><td class="text-muted">Descripción</td><td id="verDescripcion"></td></tr>
                                    <tr><td class="text-muted">Categoría</td><td id="verCategoria"></td></tr>
                                    <tr><td class="text-muted">Energía</td><td id="verEnergia"></td></tr>
                                    <tr><td class="text-muted">Duración</td><td id="verDuracion"></td></tr>
                                    <tr><td class="text-muted">Ubicación</td><td id="verIndoor"></td></tr>
                                    <tr><td class="text-muted">Modalidad</td><td id="verIndividual"></td></tr>
                                    <tr><td class="text-muted">Creada por</td><td id="verCreadaPor"></td></tr>
                                </table>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MODAL CREAR ACTIVIDAD -->
                <div class="modal fade" id="modalCrear" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Nueva actividad</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">Nombre</label>
                                        <input type="text" id="crearNombre" class="form-control" required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Descripción</label>
                                        <textarea id="crearDescripcion" class="form-control" rows="3"></textarea>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <label class="form-label">Categoría</label>
                                        <select id="crearCategoria" class="form-select">
                                            <option value="">Sin categoría</option>
                                            <option value="1">Relajación</option>
                                            <option value="2">Actividad física</option>
                                            <option value="3">Creatividad</option>
                                            <option value="4">Social</option>
                                            <option value="5">Bienestar</option>
                                            <option value="6">Naturaleza</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <label class="form-label">Nivel de energía</label>
                                        <select id="crearEnergia" class="form-select">
                                            <option value="baja">Baja</option>
                                            <option value="media">Media</option>
                                            <option value="alta">Alta</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <label class="form-label">Duración (minutos)</label>
                                        <input type="number" id="crearDuracion" class="form-control">
                                    </div>
                                    <div class="col-12 col-sm-6 d-flex align-items-end gap-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="crearIndoor">
                                            <label class="form-check-label" for="crearIndoor">Interior</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="crearIndividual">
                                            <label class="form-check-label" for="crearIndividual">Individual</label>
                                        </div>
                                    </div>
                                </div>
                                <p id="errorCrear" class="text-danger small d-none mt-3">Error al crear la actividad</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-primary" id="btnGuardarActividad">Guardar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MODAL EDITAR ACTIVIDAD -->
                <div class="modal fade" id="modalEditar" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Editar actividad</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Nombre</label>
                                    <input type="text" id="editNombre" class="form-control" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Descripción</label>
                                    <textarea id="editDescripcion" class="form-control" rows="3"></textarea>
                                </div>
                                <p id="errorEditar" class="text-danger small d-none">Error al guardar la actividad</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" class="btn btn-primary" onclick="guardarEdicion()">Guardar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MODAL STATS -->
                <div class="modal fade" id="modalStats" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="modalStatsNombre"></h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row g-2 mb-3">
                                    <div class="col-12 col-sm-6">
                                        <div class="admin-stat-card text-center">
                                            <div class="admin-stat-label">Veces realizada</div>
                                            <div class="admin-stat-value" id="statsRealizadas">—</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="admin-stat-card text-center">
                                            <div class="admin-stat-label">Usuarios únicos</div>
                                            <div class="admin-stat-value" id="statsUsuarios">—</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="admin-stat-card text-center">
                                            <div class="admin-stat-label">Valoración media</div>
                                            <div class="admin-stat-value" id="statsValoracion">—</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="admin-stat-card text-center">
                                            <div class="admin-stat-label">Tasa de éxito</div>
                                            <div class="admin-stat-value" id="statsExito">—</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="admin-table">
                                        <tr>
                                            <td class="text-muted">Emoción más frecuente antes</td>
                                            <td id="statsEmocion">—</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="admin-card">
                    <div class="admin-card-header">
                        <span class="fw-500">Actividades</span>
                        <input type="text" id="buscador" class="admin-search ms-auto" placeholder="Buscar..."/>
                        <button class="admin-filter-btn active" data-filtro="todas">Todas</button>
                        <button class="admin-filter-btn" data-filtro="activas">Activas</button>
                        <button class="admin-filter-btn" data-filtro="inactivas">Inactivas</button>
                        <button class="admin-filter-btn" data-filtro="indoor">Indoor</button>
                        <button class="admin-filter-btn" data-filtro="outdoor">Outdoor</button>
                        <button class="admin-filter-btn" data-filtro="individual">Individual</button>
                        <button class="admin-filter-btn" data-filtro="grupo">Grupo</button>
                        <button class="admin-btn-primary ms-2" data-bs-toggle="modal" data-bs-target="#modalCrear">+ Crear</button>
                    </div>
                    <div class="table-responsive">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th class="d-none d-xl-table-cell">Categoría</th>
                                    <th class="d-none d-xl-table-cell">Energía</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tablaActividades">
                                <% actividades.forEach(a => { %>
                                <tr
                                    data-id="<%= a.id %>"
                                    data-nombre="<%= a.name.toLowerCase() %>"
                                    data-activo="<%= a.activo %>"
                                    data-indoor="<%= a.indoor %>"
                                    data-individual="<%= a.individual %>"
                                    data-descripcion="<%= (a.description || '').replace(/\"/g, '&quot;') %>"
                                    data-categoria="<%= a.category || 'Sin categoría' %>"
                                    data-energia="<%= a.energy_level %>"
                                    data-duracion="<%= a.duration_minutes %>"
                                    data-creada-por="<%= (a.created_by_nombre && a.created_by_nombre !== 'null') ? a.created_by_nombre + ' (' + a.created_by_email + ')' : (a.created_by_email || '—') %>"
                                >
                                    <td><%= a.name %></td>
                                    <td class="text-muted d-none d-xl-table-cell"><%= a.category || 'Sin categoría' %></td>
                                    <td class="d-none d-xl-table-cell">
                                        <% const energyClass = a.energy_level === 'baja' ? 'admin-badge-green' : a.energy_level === 'media' ? 'admin-badge-yellow' : 'admin-badge-red'; %>
                                        <span class="admin-badge <%= energyClass %>"><%= a.energy_level %></span>
                                    </td>
                                    <td>
                                        <span class="admin-badge estado-badge <%= a.activo ? 'admin-badge-green' : 'admin-badge-red' %>">
                                            <%= a.activo ? 'Activa' : 'Inactiva' %>
                                        </span>
                                    </td>
                                    <td>
                                        <button class="admin-btn btn-ver" data-id="<%= a.id %>">
                                            <i class="bi bi-eye"></i><span class="d-none d-xl-inline ms-1">Ver</span>
                                        </button>
                                        <button class="admin-btn btn-editar"
                                            data-id="<%= a.id %>"
                                            data-nombre="<%= a.name %>"
                                            data-descripcion="<%= (a.description || '').replace(/\"/g, '&quot;') %>">
                                            <i class="bi bi-pencil"></i><span class="d-none d-xl-inline ms-1">Editar</span>
                                        </button>
                                        <button class="admin-btn btn-stats" data-id="<%= a.id %>" data-nombre="<%= a.name %>">
                                            <i class="bi bi-bar-chart"></i><span class="d-none d-xl-inline ms-1">Stats</span>
                                        </button>
                                        <button class="admin-btn btn-toggle-activo"
                                            data-id="<%= a.id %>"
                                            data-activo="<%= a.activo %>">
                                            <% if (a.activo) { %>
                                                <i class="bi bi-x-circle"></i><span class="d-none d-xl-inline ms-1">Desactivar</span>
                                            <% } else { %>
                                                <i class="bi bi-check-circle"></i><span class="d-none d-xl-inline ms-1">Activar</span>
                                            <% } %>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/js/adminActividades.js"></script>
    </body>
</html>
